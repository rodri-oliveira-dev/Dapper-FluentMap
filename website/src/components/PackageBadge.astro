---
interface Props { name: string; href?: string; locale?: 'en' | 'pt-br' }
const { name, href = `https://www.nuget.org/packages/${name}`, locale = 'en' } = Astro.props;
const pt = locale === 'pt-br';
---
<aside class="package-badge" aria-label={`${pt ? 'Pacote NuGet necessário' : 'Required NuGet package'}: ${name}`}>
  <div><small>{pt ? 'Pacote NuGet' : 'NuGet package'}</small><a href={href}>{name}</a></div>
</aside>
