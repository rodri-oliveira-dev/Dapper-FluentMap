<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>Dapper.FluentMap</PackageId>
    <Title>Dapper.FluentMap</Title>
    <Description>Fluent property-to-column mapping for Dapper, including explicit maps, naming conventions, profiles, diagnostics, and supported immutable object materialization.</Description>
    <VersionPrefix>$(FluentMapPackageVersionPrefix)</VersionPrefix>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>8.0</LangVersion>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageTags>dapper;fluent-mapping;mapping;micro-orm;database;sql;poco;fluentmap</PackageTags>
    <EnablePackageValidation>true</EnablePackageValidation>
    <PackageValidationBaselineVersion Condition="'$(EnableFluentMapHistoricalApiCompatValidation)' == 'true'">2.0.0</PackageValidationBaselineVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Dapper" Version="$(DapperPackageVersion)" />
    <PackageReference Include="Microsoft.Bcl.AsyncInterfaces" Version="10.0.11" />
  </ItemGroup>
</Project>
