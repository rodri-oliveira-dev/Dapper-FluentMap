# Normalize text files and keep diffs stable across Windows, Linux and CI.
* text=auto eol=lf

# Code and project/configuration files use LF explicitly.
*.cs             text eol=lf
*.csproj         text eol=lf
*.props          text eol=lf
*.targets        text eol=lf
*.sln            text eol=lf
*.slnx           text eol=lf
*.json           text eol=lf
*.xml            text eol=lf
*.yaml           text eol=lf
*.yml            text eol=lf
*.md             text eol=lf
*.editorconfig   text eol=lf
*.gitignore      text eol=lf
*.gitattributes  text eol=lf
*.sh             text eol=lf
*.ps1            text eol=lf

# cmd.exe scripts remain CRLF for compatibility with Windows tooling.
*.cmd            text eol=crlf
*.bat            text eol=crlf

# Binary files must not be normalized as text.
*.png            binary
*.jpg            binary
*.jpeg           binary
*.gif            binary
*.ico            binary
*.pdf            binary
*.zip            binary
*.dll            binary
*.exe            binary
*.nupkg          binary
*.snupkg         binary
